# Copy this file to .env.local, then `npx next dev`.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored, so every checkout needs this step once.

# The shared cloud deployment. Not secret — NEXT_PUBLIC_* values are compiled
# into the browser bundle and visible to anyone who loads the page. The secrets
# (BOOTH_SECRET, GMI_API_KEY) live on the deployment itself, set with
# `npx convex env set`, and never appear here.
NEXT_PUBLIC_CONVEX_URL=https://jovial-bullfrog-243.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://jovial-bullfrog-243.convex.site

# Where the booth's QR code sends a phone. Must be reachable FROM THE PHONE, so
# localhost is useless here — and the phone has to be on the same Wi-Fi as
# whoever is running `next dev`. Set it to that machine's LAN IP
# (`ipconfig getifaddr en0` on macOS, `hostname -I` on Linux), or to the
# deployed URL once the frontend is hosted.
# Unset is fine for booth work on one machine — it falls back to
# window.location.origin, and only the QR handoff is affected.
# NEXT_PUBLIC_BOOTH_PUBLIC_URL=http://192.168.1.50:3000

# WorkOS AuthKit — inherited from the template, unused. The app has no login:
# sessions are gated by the random token in the QR link.
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_COOKIE_PASSWORD=
