{
    "name": "Photobooth Dev",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "remoteUser": "node",
    "runArgs": [
        "--dns=8.8.8.8",
        "--dns=1.1.1.1"
    ],
    "forwardPorts": [
        8081,
        3000
    ],
    "postCreateCommand": "sudo chown -R node:node /home/node/.claude-config && npm ci --prefix boothinator && npm ci --prefix my-app",
    "mounts": [
        "source=claude-code-config,target=/home/node/.claude-config,type=volume"
    ],
    "remoteEnv": {
        "CLAUDE_CONFIG_DIR": "/home/node/.claude-config",
        "REACT_NATIVE_PACKAGER_HOSTNAME": "${localEnv:REACT_NATIVE_PACKAGER_HOSTNAME}"
    }
}
